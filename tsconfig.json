{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "types": ["vite/client"],
        "paths": {
            "@/*": ["./resources/js/*"]
        },
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.vue", "tests/js/**/*.ts"]
}
